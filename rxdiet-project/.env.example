# Documents the environment variables needed by the backend and local Vite frontend.
# Copy this file to .env locally and replace placeholder values with real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require
PORT=3000
SESSION_DURATION_DAYS=7

# Required only when running the Vite dev server separately from the backend.
VITE_API_BASE_URL=http://localhost:3000
